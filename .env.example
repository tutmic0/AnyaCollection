# Copy the values from your own accounts -- never commit a real .env
# file, and never paste these values into chat. In Vercel, these go
# under Project Settings -> Environment Variables instead of a file.

# From Supabase -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-KEEP-SECRET

# Robinhood Chain mainnet. The public RPC is rate-limited; switch to a
# provider (e.g. Alchemy's robinhood-mainnet.g.alchemy.com/v2/KEY) once
# you're past testing. Chain ID is 4663.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# The deployed LivingAdventurer contract address, once you've deployed it.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Your live site domain, used to build external_url links in metadata.
SITE_URL=https://yoursite.example

# Used only until real per-combination images exist -- every token
# shows this until its exact tier combo has a generated image cached.
FALLBACK_IMAGE_URL=https://yoursite.example/img/tier1-default.png

# Signs session tokens issued after wallet sign-in. Generate your own
# random value -- do NOT use this example. In a terminal:
#   openssl rand -hex 32
SESSION_JWT_SECRET=replace-with-a-random-64-character-hex-string
